[Unit]
Description=NLP Search site reverse SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/shwstone
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -o TCPKeepAlive=yes -R 127.0.0.1:18081:127.0.0.1:18083 Aliyun
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
